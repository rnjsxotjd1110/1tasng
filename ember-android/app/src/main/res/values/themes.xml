<resources>
    <style name="Theme.Ember" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ember_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Ember.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ember_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ember_icon_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Ember</item>
    </style>
</resources>
